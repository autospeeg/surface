[Unit]
Description=Surface identity-repo sync server
After=network.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=__REPO_DIR__/.env
ExecStart=__REPO_DIR__/.venv/bin/python __REPO_DIR__/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
